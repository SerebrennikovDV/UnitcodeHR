# Скопировать в .env и заполнить значениями. Файл .env в репозиторий не коммитить.

# Секреты Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (PostgreSQL)
# Формат: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://unitcode_hr_app:password@localhost:5432/unitcode_hr

# Электронная почта (для уведомлений)
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=UnitcodeHR <no-reply@unitcode.ru>

# Параметры скрининга
SCREENING_AUTO_REJECT_THRESHOLD=50.0
SCREENING_RECOMMEND_THRESHOLD=70.0

# API-ключи внешних коннекторов (mock-режим, могут быть пустыми)
HH_API_BASE=https://api.hh.ru
SUPERJOB_API_KEY=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Использовать заглушки вместо реальных HTTP-запросов
CONNECTORS_MOCK_MODE=True
